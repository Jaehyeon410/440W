# Backend environment configuration
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file

# ------------------------------------------------------------------
# REQUIRED: Google Gemini API key
# Get one at https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ------------------------------------------------------------------
# Optional: Gemini text model override
# ------------------------------------------------------------------
GEMINI_TEXT_MODEL=gemini-2.0-flash

# ------------------------------------------------------------------
# Optional: Enable on-demand Gemini metadata generation
# When "0" (default), uses local fallback metadata (faster).
# Set to "1" to allow Gemini to generate metadata for unknown ingredients.
# ------------------------------------------------------------------
ENABLE_GEMINI_METADATA=0
